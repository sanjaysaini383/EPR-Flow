# ── Database ───────────────────────────────────────────────
# Local (docker compose up -d): both URLs point at the same Postgres.
# Neon: DATABASE_URL = pooled connection string (host contains "-pooler"),
#       DIRECT_URL   = direct connection string (used only by `prisma migrate`).
DATABASE_URL="postgresql://eprflow:eprflow@localhost:5433/eprflow"
DIRECT_URL="postgresql://eprflow:eprflow@localhost:5433/eprflow"

# ── Auth.js ────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Optional — Google login is shown only when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── App ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Email (Mailpit in dev; any SMTP provider in prod) ───────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="EPRFlow <no-reply@eprflow.local>"

# ── AI (Phase 5) ───────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── File storage (Phase 4) ─────────────────────────────────
STORAGE_DRIVER="local" # local | s3
