# ── Database (Neon) ────────────────────────────────────────
# Neon console → your project → Connect. Use a separate branch (e.g. "dev")
# for local development so production data is never touched.
# DATABASE_URL = pooled connection string (host contains "-pooler") — used by the app
# DIRECT_URL   = direct connection string — used only by `prisma migrate`
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Optional — Google login is shown only when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── App ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Email (any SMTP provider, e.g. Resend / SES / Brevo) ────
# Leave SMTP_HOST empty in development: emails are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="EPRFlow <no-reply@eprflow.local>"

# ── AI (Phase 5) ───────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ── File storage (Phase 4) ─────────────────────────────────
STORAGE_DRIVER="blob" # blob (Vercel Blob) | s3
BLOB_READ_WRITE_TOKEN=""
