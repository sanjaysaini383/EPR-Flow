# ── Database (Neon) ────────────────────────────────────────
# Neon console → your project → Connect. Use a separate branch (e.g. "dev")
# for local development so production data is never touched.
# DATABASE_URL = pooled connection string (host contains "-pooler") — used by the app
# DIRECT_URL   = direct connection string — used only by `prisma migrate`
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# ── Auth.js ────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Optional — Google login is shown only when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── App ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Vercel Cron sends this as a Bearer token; generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Email (any SMTP provider, e.g. Resend / SES / Brevo) ────
# Leave SMTP_HOST empty in development: emails are printed to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="EPRFlow <no-reply@eprflow.local>"

# ── AI document extraction ─────────────────────────────────
# Without a key, uploads still work and values are entered by hand.
ANTHROPIC_API_KEY=""
# Model used to read certificates and invoices (defaults to claude-opus-5-5).
ANTHROPIC_MODEL="claude-opus-5-5"
# Development only: AI_PROVIDER="fake" returns fixed sample data (used by e2e tests; ignored in production).
AI_PROVIDER=""

# ── File storage ───────────────────────────────────────────
# blob = private Vercel Blob (production); database = files in Postgres (local dev, small deployments).
# With "blob" but no token, development falls back to the database driver.
STORAGE_DRIVER="blob"
BLOB_READ_WRITE_TOKEN=""
